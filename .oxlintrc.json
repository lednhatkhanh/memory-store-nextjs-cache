{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "nextjs", "node", "promise", "react", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-default-export": "off",
    "oxc/no-barrel-file": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/react-in-jsx-scope": "off",
    "react/unsupported-syntax": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["packages/cache/test/**/*.ts"],
      "rules": {
        "import/no-relative-parent-imports": "off"
      }
    },
    {
      "files": ["packages/cache/rspack.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["packages/cache/src/next-handler.ts"],
      "rules": {
        "import/no-default-export": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["packages/cache/test/redis-cache-handler.test.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["apps/web/app/layout.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ],
  "ignorePatterns": [".next/**", "dist/**", "node_modules/**"]
}
