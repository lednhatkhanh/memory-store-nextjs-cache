{
  "name": "memory-store-nextjs-cache",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "format": "oxfmt .",
    "format:check": "turbo run format:check",
    "format:check:root": "oxfmt --check .",
    "lint": "turbo run lint",
    "measure:cache-resources": "pnpm --filter unicorn-nextjs-memory-cache measure:resources",
    "test": "turbo run test",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2"
}
