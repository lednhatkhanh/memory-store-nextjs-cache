{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".oxlintrc.json", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "//#format:check:root": {
      "inputs": ["$TURBO_DEFAULT$", ".oxfmtrc.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", ".oxlintrc.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
